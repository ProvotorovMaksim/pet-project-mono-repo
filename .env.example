# Shared application settings
JWT_SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas

# API Gateway
SERVICES_URLS=http://gateway-api:8000
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_ROOT_URL=http://localhost:3000

# E-commerce VPN
VPN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@vpn-db:5432/saas
DATABASE_DRIVER=postgresql+asyncpg
TELEGRAM_TOKEN=replace-me
GIGACHAT_CREDENTIALS=replace-me
AUTH_SERVICE_URL=http://registry-app:8001
BILLING_SERVICE_URL=http://billing-service:8002

# Registration backend
REGISTRY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@registry-db:5432/saas
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Notification service
BOT_TOKEN=replace-me
CHAT_ID=replace-me
MAIL_USER=replace-me
MAIL_PASSWORD=replace-me
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=no-reply@example.com

# Optional external service URLs
SERVICE_URL=http://localhost
